{
  "name": "agent-usage-all-in-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-usage": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "svelte-kit sync && vite build && tsup",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "pnpm check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "latest",
    "open": "latest",
    "protobufjs": "^8.0.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@sveltejs/adapter-static": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-plugin-svelte": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prettier-plugin-svelte": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "tslib": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "~6.0.0",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
